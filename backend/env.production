JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@sbtsgroup.com

# Payment Gateway Configuration (for future use)
PAYSTACK_SECRET_KEY=sk_test_5f13217e1817b69f9f5fe742d14c87230661b8fc
PAYSTACK_PUBLIC_KEY=pk_test_634578ea385699eabe165cb56312b6cafd7f762a
